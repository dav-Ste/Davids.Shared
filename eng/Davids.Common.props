<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsAsErrors>$(WarningsAsErrors);NU1900;NU1901;NU1902;NU1903;NU1904</WarningsAsErrors>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisModeSecurity>All</AnalysisModeSecurity>
    <UseSharedPackageReference Condition="'$(UseSharedPackageReference)' == ''">false</UseSharedPackageReference>
    <DavidsServiceDefaultsVersion Condition="'$(DavidsServiceDefaultsVersion)' == ''">1.0.0</DavidsServiceDefaultsVersion>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NuGetLockFilePath Condition="'$(UseSharedPackageReference)' == 'true' and '$(NuGetLockFilePath)' == ''">$(_DirectoryBuildPropsBasePath)/artifacts/obj/$(MSBuildProjectName)/packages.pkgref.lock.json</NuGetLockFilePath>
  </PropertyGroup>
</Project>
